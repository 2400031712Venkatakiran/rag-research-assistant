# --- Retrieval ---
RETRIEVAL_METHOD=dense
TOP_K=4

# --- Storage / ingestion ---
CHROMA_DIR=./data/chroma
COLLECTION_NAME=documents
DOCUMENTS_DIR=./documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Models (provider:model is resolved by LangChain's init_embeddings / init_chat_model) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- Secrets (read directly by the provider packages) ---
OPENAI_API_KEY=
# GOOGLE_API_KEY=

LOG_LEVEL=INFO
